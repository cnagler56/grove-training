# Local dev environment for the Next.js grove-front.
#
# Usage:
#   1. Copy this file to `.env.local` (gitignored by Next.js convention).
#   2. `npm run dev` automatically picks up `.env.local`.
#
# In production set the same var in Vercel's project settings.

# Where GroveServer is running. Defaults to localhost:8084 in api.ts if
# not set, but production must point at the real backend URL (with HTTPS).
NEXT_PUBLIC_API_URL=http://localhost:8084
